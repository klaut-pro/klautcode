{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": ["CI", "KLAUTCODE_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "KLAUTCODE_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "klautcode#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["*"]
    },
    "@klautcode/core#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@klautcode/app#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@klautcode/ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@klautcode/session-ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
